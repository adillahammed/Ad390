// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Client {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  company   String?
  role      String   @default("CLIENT") // Enforced RBAC
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings  Booking[]
}

model Vendor {
  id           String      @id @default(uuid())
  email        String      @unique
  password     String
  name         String
  company      String
  phone        String?
  role         String      @default("VENDOR") // Enforced RBAC
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  billboards   Billboard[]
  bookings     Booking[]
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN") // Enforced RBAC
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Billboard {
  id           String   @id @default(uuid())
  title        String
  location     String
  city         String
  type         String   // e.g. Digital, Static, 3D Digital
  size         String
  dailyTraffic Int
  pricePerDay  Float
  image        String
  tags         String   // JSON stringified array or comma separated
  available    Boolean  @default(true)
  
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id])
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  bookings     Booking[]
}

model Booking {
  id          String   @id @default(uuid())
  startDate   DateTime
  endDate     DateTime
  totalPrice  Float
  bidAmount   Float    @default(0) // New field for auction bidding
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  campaign    String?
  
  billboardId String
  billboard   Billboard @relation(fields: [billboardId], references: [id])
  
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id])
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
